model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Vendedor","Sucursal","Promocion","Producto","MedioPago","EstadoPedido","Cliente","Canal","factVentas","Obj2024","Obj2025","Objetivo"]

annotation PBI_ProTooling = ["DevMode"]

ref table Vendedor
ref table Sucursal
ref table Promocion
ref table Producto
ref table MedioPago
ref table EstadoPedido
ref table Cliente
ref table Canal
ref table factVentas
ref table Tiempo
ref table Objetivo
ref table Medidas

ref cultureInfo en-US

