table Medidas
	lineageTag: edc85ad4-a37a-4d06-92af-ac7406ec9993

	/// Suma de Importe_Neto de las ventas efectivas (Es_Venta_Efectiva = "Sí")
	measure 'Venta Neta' =
			CALCULATE (
			    SUM ( factVentas[Importe_Neto] ),
			    KEEPFILTERS ( EstadoPedido[Es_Venta_Efectiva] = "Sí" )
			)
		formatString: \$ #,0
		displayFolder: 1. Ventas
		lineageTag: 7d509bee-37e6-4651-8c1b-490325afaaf9

	/// Margen bruto en pesos de las ventas efectivas
	measure 'Margen Bruto' =
			CALCULATE (
			    SUM ( factVentas[Margen_Bruto] ),
			    KEEPFILTERS ( EstadoPedido[Es_Venta_Efectiva] = "Sí" )
			)
		formatString: \$ #,0
		displayFolder: 1. Ventas
		lineageTag: 3d93aa3f-d613-4675-b442-a9e7ccd652bc

	/// Margen bruto sobre venta neta
	measure 'Margen Bruto %' = DIVIDE ( [Margen Bruto], [Venta Neta] )
		formatString: 0.0%
		displayFolder: 1. Ventas
		lineageTag: ef884acd-6353-4a4c-a76e-29f638062cd8

	/// Unidades vendidas en ventas efectivas
	measure Unidades =
			CALCULATE (
			    SUM ( factVentas[Cantidad] ),
			    KEEPFILTERS ( EstadoPedido[Es_Venta_Efectiva] = "Sí" )
			)
		formatString: #,0
		displayFolder: 1. Ventas
		lineageTag: 9f7ec5de-4b5f-4e4e-ac75-f06e72bd42b5

	/// Cantidad de comprobantes emitidos (ventas efectivas). Según el Diccionario, cada fila de factVentas es un comprobante
	measure Comprobantes =
			CALCULATE (
			    COUNTROWS ( factVentas ),
			    KEEPFILTERS ( EstadoPedido[Es_Venta_Efectiva] = "Sí" )
			)
		formatString: #,0
		displayFolder: 1. Ventas
		lineageTag: 2aa918fb-f381-4c60-a255-f2da6d76dbfe

	/// Venta neta por comprobante emitido
	measure 'Ticket Promedio' = DIVIDE ( [Venta Neta], [Comprobantes] )
		formatString: \$ #,0
		displayFolder: 1. Ventas
		lineageTag: 94fdb449-87fc-40ed-87e3-5a4854eeda01

	/// Venta neta usando la fecha de entrega (activa la relación inactiva factVentas[Fecha_Entrega] -> Tiempo[Fecha])
	measure 'Venta Neta por Fecha Entrega' =
			CALCULATE (
			    [Venta Neta],
			    USERELATIONSHIP ( factVentas[Fecha_Entrega], Tiempo[Fecha] )
			)
		formatString: \$ #,0
		displayFolder: 1. Ventas
		lineageTag: 3c32c7dd-1956-4440-bf7b-90aaf14aadcd

	/// Venta neta del mismo período del ejercicio anterior
	measure 'Venta Neta EA' = CALCULATE ( [Venta Neta], SAMEPERIODLASTYEAR ( Tiempo[Fecha] ) )
		formatString: \$ #,0
		displayFolder: 4. Comparativos
		lineageTag: 92e73737-25e1-4add-a260-d2b83bdbf7fd

	/// Variación % de la venta neta contra el ejercicio anterior
	measure 'Var. vs Ejercicio Anterior' = DIVIDE ( [Venta Neta] - [Venta Neta EA], [Venta Neta EA] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4. Comparativos
		lineageTag: 007b22c4-61a8-49a7-afa7-9d507845d0eb

	/// Venta neta acumulada del ejercicio fiscal (cierra el 30/06)
	measure 'Venta Neta Acum. Ejercicio' = TOTALYTD ( [Venta Neta], Tiempo[Fecha], "6/30" )
		formatString: \$ #,0
		displayFolder: 4. Comparativos
		lineageTag: c07f984a-5f5b-41ff-884b-e3f17c444bb1

	/// Clientes distintos con compras efectivas en el período
	measure 'Clientes Activos' =
			CALCULATE (
			    DISTINCTCOUNT ( factVentas[ID_Cliente] ),
			    KEEPFILTERS ( EstadoPedido[Es_Venta_Efectiva] = "Sí" )
			)
		formatString: #,0
		displayFolder: 2. Clientes
		lineageTag: d005d67e-5aea-4042-8028-e82ac65b2299

	/// Clientes dados de alta en el período (Cliente[Fecha_Alta] filtrada por Tiempo sin relación física)
	measure 'Clientes Nuevos' =
			CALCULATE (
			    COUNTROWS ( Cliente ),
			    TREATAS ( VALUES ( Tiempo[Fecha] ), Cliente[Fecha_Alta] )
			)
		formatString: #,0
		displayFolder: 2. Clientes
		lineageTag: 108e90d0-598c-4ca5-9bb3-d244505aba76

	/// Promedio del rating de satisfacción (1-5). Vacío en Cancelados y En Tránsito, AVERAGE los ignora
	measure 'Rating Promedio' = AVERAGE ( factVentas[Rating_Satisfaccion] )
		formatString: 0.00
		displayFolder: 2. Clientes
		lineageTag: 9748ac9e-4e86-4c36-acbd-9c5cdee13396

	/// Comprobantes con estado Devuelto
	measure 'Pedidos Devueltos' =
			CALCULATE (
			    COUNTROWS ( factVentas ),
			    KEEPFILTERS ( EstadoPedido[Estado_Pedido] = "Devuelto" )
			)
		formatString: #,0
		displayFolder: 2. Clientes
		lineageTag: dcae97db-65ae-4b8b-9e75-199f191ac091

	/// Pedidos devueltos sobre el total de pedidos (todos los estados)
	measure 'Tasa de Devolución' = DIVIDE ( [Pedidos Devueltos], COUNTROWS ( factVentas ) )
		formatString: 0.0%
		displayFolder: 2. Clientes
		lineageTag: af3697a7-2b74-48ad-8c04-d3b1f28344d3

	/// Participación de la venta neta sobre el total visible (respeta segmentadores)
	measure '% Participación' = DIVIDE ( [Venta Neta], CALCULATE ( [Venta Neta], ALLSELECTED ( Cliente ) ) )
		formatString: 0.0%
		displayFolder: 2. Clientes
		lineageTag: 13f1a0e0-2af0-44b1-b29d-e630356fc110

	/// Participación de la venta neta del cliente dentro de su segmento. Quita solo el filtro de Cliente[Cliente], así no la afecta el filtro Top N del visual
	measure '% Participación en Segmento' = DIVIDE ( [Venta Neta], CALCULATE ( [Venta Neta], REMOVEFILTERS ( Cliente[Cliente] ) ) )
		formatString: 0.0%
		displayFolder: 2. Clientes
		lineageTag: b01b7687-1340-4575-a016-feab218d7478

	/// Suma del objetivo mensual de venta neta de los vendedores
	measure Objetivo = SUM ( Objetivo[Objetivo] )
		formatString: \$ #,0
		displayFolder: 3. Objetivos
		lineageTag: 84626062-0546-4ef9-bead-81db366ac4ec

	/// Venta neta sobre objetivo
	measure '% Cumplimiento' = DIVIDE ( [Venta Neta], [Objetivo] )
		formatString: 0.0%
		displayFolder: 3. Objetivos
		lineageTag: 91df01c2-3f4a-4f81-845a-a34234b5be11

	/// Diferencia en pesos entre venta neta y objetivo
	measure 'Brecha vs Objetivo' = IF ( NOT ISBLANK ( [Objetivo] ), [Venta Neta] - [Objetivo] )
		formatString: \$ #,0;-\$ #,0;\$ #,0
		displayFolder: 3. Objetivos
		lineageTag: 79fe8d45-0bd1-41bc-be0f-5a1fa569ad82

	/// Objetivo acumulado del ejercicio fiscal
	measure 'Objetivo Acum. Ejercicio' = TOTALYTD ( [Objetivo], Tiempo[Fecha], "6/30" )
		formatString: \$ #,0
		displayFolder: 3. Objetivos
		lineageTag: 898e6410-e523-4148-8959-da1c9a1d8aa7

	/// Ranking de vendedores por % de cumplimiento (solo vendedores con objetivo)
	measure 'Ranking Cumplimiento' =
			IF (
			    ISINSCOPE ( Vendedor[Vendedor] ) && NOT ISBLANK ( [Objetivo] ),
			    RANKX (
			        FILTER ( ALLSELECTED ( Vendedor[Vendedor] ), NOT ISBLANK ( [Objetivo] ) ),
			        [% Cumplimiento],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		displayFolder: 3. Objetivos
		lineageTag: 80a69951-e070-4856-a4db-7139c127a611

	column Column
		isHidden
		formatString: 0
		lineageTag: 6929b414-2848-43ed-b2c1-232e6a7826d0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Medidas = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = b180881a918f47de86463ac398977ea4

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

