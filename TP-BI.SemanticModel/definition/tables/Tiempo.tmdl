		lineageTag: 77627a98-aa99-41d3-ae35-d6900f432067
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Codigo Mes Fiscal]

		annotation SummarizationSetBy = Automatic

	partition Tiempo = calculated
		mode: import
		source = ```
				
				SELECTCOLUMNS (
				    ADDCOLUMNS (
				        CALENDAR (
				            MIN ( factVentas[Fecha_Venta] ),
				            MAX ( factVentas[Fecha_Venta] )
				        ),
				        "Codigo Fecha", FORMAT ( [Date], "YYYYMMDD" ),
				        "Año", YEAR ( [Date] ),
				        "Mes", FORMAT ( [Date], "MM" ),
				        "Codigo Mes", FORMAT ( [Date], "YYYYMM" ),
				        "Anio Mes Corto", FORMAT ( [Date], "YYYY" ) & " " & UPPER ( LEFT ( FORMAT ( [Date], "mmm" ), 1 ) ) & RIGHT ( FORMAT ( [Date], "mmm" ), LEN ( FORMAT ( [Date], "mmm" ) ) - 1 ),
				        "Mes Corto", UPPER ( LEFT ( FORMAT ( [Date], "mmm" ), 1 ) ) & RIGHT ( FORMAT ( [Date], "mmm" ), LEN ( FORMAT ( [Date], "mmm" ) ) - 1 ),
				        "Mes Largo", UPPER ( LEFT ( FORMAT ( [Date], "mmmm" ), 1 ) ) & RIGHT ( FORMAT ( [Date], "mmmm" ), LEN ( FORMAT ( [Date], "mmmm" ) ) - 1 ),
				        "Codigo Dia Semana", WEEKDAY ( [Date] ),
				        "Dia Semana", UPPER ( LEFT ( FORMAT ( [Date], "dddd" ), 1 ) ) & RIGHT ( FORMAT ( [Date], "dddd" ), LEN ( FORMAT ( [Date], "dddd" ) ) - 1 ),
				        "Dia Semana Corto", UPPER ( LEFT ( FORMAT ( [Date], "ddd" ), 1 ) ) & RIGHT ( FORMAT ( [Date], "ddd" ), LEN ( FORMAT ( [Date], "ddd" ) ) - 1 ),
				        "Codigo Trimeste", YEAR ( [Date] ) * 100 + QUARTER ( [Date] ),
				        "Trimestre", "Q" & FORMAT ( [Date], "Q" ),
				        "Anio Trimestre", FORMAT ( [Date], "YYYY" ) & " Q" & FORMAT ( [Date], "Q" ),
				        -- Ejercicio fiscal (01/07/N al 30/06/N+1)
				        "Ejercicio", IF ( MONTH ( [Date] ) >= 7, YEAR ( [Date] ), YEAR ( [Date] ) - 1 ),
				        "Mes Fiscal Nro", MOD ( MONTH ( [Date] ) - 7, 12 ) + 1
				    ),
				    "Fecha", [Date],
				    "Codigo Fecha", [Codigo Fecha],
				    "Año", [Año],
				    "Mes", [Mes],
				    "Codigo Mes", [Codigo Mes],
				    "Anio Mes Corto", [Anio Mes Corto],
				    "Mes Corto", [Mes Corto],
				    "Mes Largo", [Mes Largo],
				    "Codigo Dia Semana", [Codigo Dia Semana],
				    "Dia Semana", [Dia Semana],
				    "Dia Semana Corto", [Dia Semana Corto],
				    "Codigo Trimeste", [Codigo Trimeste],
				    "Trimestre", [Trimestre],
				    "Anio Trimestre", [Anio Trimestre],
				    "Ejercicio", [Ejercicio],
				    "Ejercicio Desc", "Ej. " & [Ejercicio] & "/" & RIGHT ( [Ejercicio] + 1, 2 ),
				    "Mes Fiscal Nro", [Mes Fiscal Nro],
				    "Codigo Mes Fiscal", [Ejercicio] * 100 + [Mes Fiscal Nro]
				)
				
				```

	annotation PBI_Id = 03c14729b3714b3094e742185dde38b5

